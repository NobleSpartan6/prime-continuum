#!/bin/sh
set -eu
if [ -z "${PRIME_CONTINUIM_BROWSER_EXECUTABLE:-}" ] || [ -z "${PRIME_CONTINUIM_BROWSER_BRIDGE:-}" ]; then
  echo "Verified browser execution is unavailable for this resident session." >&2
  exit 1
fi
exec "$PRIME_CONTINUIM_BROWSER_EXECUTABLE" "$PRIME_CONTINUIM_BROWSER_BRIDGE" "$@"
