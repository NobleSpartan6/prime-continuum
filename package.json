{
  "name": "prime-continuim",
  "version": "0.1.0",
  "private": true,
  "author": "Prime Continuim contributors",
  "description": "Prime Continuim — a native control surface for durable Prime Agent coding sessions",
  "main": "./out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm build:hostd && electron-vite dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "electron-vite build && pnpm build:hostd",
    "build:hostd": "node scripts/build-hostd.mjs",
    "build:hostd:release": "node scripts/build-hostd.mjs --attestation out/main/runtime-attestation.json",
    "build:attestation": "node scripts/generate-runtime-attestation.mjs --output out/main/runtime-attestation.json",
    "build:release": "electron-vite build && pnpm build:attestation && pnpm build:hostd:release",
    "build:runtime": "node scripts/build-prime-agent-runtime.mjs",
    "verify:runtime": "node scripts/verify-prime-agent-runtime.mjs",
    "verify:runtime:smoke": "node scripts/verify-prime-agent-runtime.mjs --smoke",
    "verify:hostd-runtime:smoke": "node scripts/verify-hostd-runtime-initialization.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "pnpm build:runtime && pnpm build:release && pnpm verify:hostd-runtime:smoke && electron-builder --dir && node scripts/verify-windows-package.mjs",
    "dist": "pnpm build:runtime && pnpm build:release && pnpm verify:hostd-runtime:smoke && electron-builder && node scripts/verify-windows-package.mjs"
  },
  "dependencies": {
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "43.3.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "jsdom": "29.0.0",
    "npm": "10.9.8",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "ai.primeintellect.continuim",
    "productName": "Prime Continuim",
    "asar": true,
    "electronFuses": {
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      "out/**/*",
      "!out/hostd/**/*",
      "!out/runtime/**/*",
      "!out/runtime-cache/**/*"
    ],
    "extraResources": [
      {
        "from": "out/hostd/hostd.cjs",
        "to": "hostd/hostd.cjs"
      },
      {
        "from": "out/runtime",
        "to": "runtime-seed",
        "filter": [
          "current.json",
          "installs/**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
