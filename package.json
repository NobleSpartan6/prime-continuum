{
  "name": "prime-continuim",
  "version": "0.1.0",
  "private": true,
  "author": "Prime Continuim contributors",
  "license": "MIT",
  "description": "Prime Continuim — a native control surface for durable Prime Agent coding sessions",
  "homepage": "https://github.com/NobleSpartan6/prime-continuum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NobleSpartan6/prime-continuum.git"
  },
  "bugs": {
    "url": "https://github.com/NobleSpartan6/prime-continuum/issues"
  },
  "keywords": [
    "prime-agent",
    "rlm",
    "coding-agent",
    "electron"
  ],
  "main": "./out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.14.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "node scripts/run-workflow.mjs dev",
    "build": "node scripts/run-workflow.mjs build",
    "build:hostd": "node scripts/run-workflow.mjs build:hostd",
    "build:hostd:release": "node scripts/run-workflow.mjs build:hostd:release",
    "build:attestation": "node scripts/run-workflow.mjs build:attestation",
    "build:release": "node scripts/run-workflow.mjs build:release",
    "build:runtime": "node scripts/run-workflow.mjs build:runtime",
    "verify:runtime": "node scripts/verify-prime-agent-runtime.mjs",
    "verify:runtime:smoke": "node scripts/verify-prime-agent-runtime.mjs --smoke",
    "verify:hostd-runtime:smoke": "node scripts/verify-hostd-runtime-initialization.mjs",
    "verify:hostd-resident-lifecycle:smoke": "node scripts/verify-hostd-resident-lifecycle.mjs",
    "verify:prime-agent-provider:e2e": "node scripts/verify-prime-agent-provider-e2e.mjs",
    "verify:prime-agent-tool-dogfood": "node scripts/verify-prime-agent-tool-dogfood.mjs",
    "verify:windows-appcontainer-probe:receipt": "node scripts/verify-windows-appcontainer-probe.mjs",
    "verify:renderer-visual": "node scripts/run-workflow.mjs verify:renderer-visual",
    "verify:macos-distribution-readiness": "node scripts/verify-macos-distribution-readiness.mjs",
    "self-build": "node scripts/self-build.mjs",
    "verify:self-build-receipt": "node scripts/self-build.mjs --verify-receipt",
    "preview": "node scripts/run-workflow.mjs preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && pnpm --filter @prime-agent/relay-server typecheck",
    "test": "vitest run && pnpm --filter @prime-agent/relay-server test",
    "test:watch": "vitest",
    "package": "node scripts/run-workflow.mjs package",
    "dist": "node scripts/run-workflow.mjs dist"
  },
  "dependencies": {
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "npm": "12.0.2",
    "resedit": "3.0.2",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "build": {
    "extends": null,
    "appId": "ai.primeintellect.continuim",
    "productName": "Prime Continuim",
    "afterPack": "scripts/after-pack-windows.mjs",
    "asar": true,
    "electronFuses": {
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "runAsNode": false
    },
    "files": [
      "out/**/*",
      "!out/hostd/**/*",
      "!out/runtime/**/*",
      "!out/runtime-cache/**/*",
      "!out/visual-qa/**/*"
    ],
    "extraResources": [
      {
        "from": "out/hostd/hostd.cjs",
        "to": "hostd/hostd.cjs"
      },
      {
        "from": "node_modules/node",
        "to": "host-runtime",
        "filter": [
          "bin/node",
          "node.exe",
          "LICENSE"
        ]
      },
      {
        "from": "node_modules/electron/dist",
        "to": "browser-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "out/runtime",
        "to": "runtime-seed",
        "filter": [
          "current.json",
          "installs/**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Prime-Continuim-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prime Continuim",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "${productName} ${version}"
    },
    "dmg": {
      "artifactName": "Prime-Continuim-${version}-macos-${arch}.${ext}",
      "backgroundColor": "#0b0f0d",
      "format": "UDZO",
      "iconSize": 96,
      "iconTextSize": 12,
      "internetEnabled": false,
      "shrink": true,
      "sign": false,
      "title": "Prime Continuim ${version}",
      "window": {
        "width": 560,
        "height": 360
      },
      "writeUpdateInfo": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "Prime Continuim accesses a Desktop workspace only after you choose it.",
        "NSDocumentsFolderUsageDescription": "Prime Continuim accesses a Documents workspace only after you choose it.",
        "NSDownloadsFolderUsageDescription": "Prime Continuim accesses a Downloads workspace only after you choose it.",
        "NSNetworkVolumesUsageDescription": "Prime Continuim accesses a workspace on a network volume only after you choose it.",
        "NSRemovableVolumesUsageDescription": "Prime Continuim accesses a workspace on a removable volume only after you choose it."
      },
      "identity": "-",
      "notarize": false,
      "signIgnore": [
        "Contents/Resources/browser-runtime/",
        "Contents/Resources/host-runtime/",
        "Contents/Resources/runtime-seed/"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
